---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { Image } from 'astro:assets';
import logo from '../assets/torbjorg-tw-logo.png';
import SoundCloudIcon from '../assets/soundcloud.svg';
import BandcampIcon from '../assets/bandcamp.svg';
---

<header>
	<nav aria-label="Main navigation">
		<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`} class="brand">
		<Image src={logo} alt="" width={64} height={64} />
		<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/works">Works</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="social-links">
			<a
				href="https://www.instagram.com/torbjorgfw/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Torbjørg Wesnes on Instagram"
			>
				<svg
				viewBox="0 0 24 24"
				width="28"
				height="28"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
				>
				<rect x="3" y="3" width="18" height="18" rx="5" />
				<circle cx="12" cy="12" r="4" />
				<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
				</svg>
			</a>
			<a
			href="https://soundcloud.com/user-808697497"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Torbjørg Wesnes on SoundCloud"
			>
			<SoundCloudIcon width={28} height={28} aria-hidden="true" />
			</a>

			<a
			href="https://twesnes.bandcamp.com/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="T Wesnes on Bandcamp"
			>
			<BandcampIcon width={28} height={28} aria-hidden="true" />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		}

.brand img {
  border-radius: 0;
}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
	}
	.internal-links a {
		white-space: nowrap;
	}
	nav a:focus-visible {
		outline: 2px solid var(--burgundy);
		outline-offset: 2px;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--charcoal);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 1000px) {
		.social-links {
			display: none;
		}
		nav {
			flex-direction: column;
			gap: 0;
		}
		.brand {
			padding: 0.5rem;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
			border-top: 1px solid var(--taupe);
		}
		.internal-links a {
			padding: 0.75rem 1rem;
		}
	}
	@media (max-width: 480px) {
		header { padding: 0 0.5rem; }
		.brand { font-size: 1rem; }
		.brand img { width: 48px; height: 48px; }
		.internal-links { justify-content: space-evenly; }
		.internal-links a {
			font-size: 1rem;
			padding: 0.75rem 0.35rem;
		}
	}
</style>
